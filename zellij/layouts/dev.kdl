layout {
  tab name="nvim" focus=true {
    pane command="nvim"
  }
  tab name="run" {
    pane
  }
  tab name="git" {
    pane split_direction="vertical" {
      pane command="lazygit"
      pane
    }
  }
  tab name="sys" {
    pane split_direction="vertical" {
      pane command="btop"
      pane
    }
  }
  tab name="todo" {
    pane command="nvim" cwd="/home/by391/work/notes"   
  }
  default_tab_template {
    pane size=1 borderless=true {
      plugin location="zellij:status-bar"
    }
    pane {
      children;
    }
    pane size=2 borderless=true {
      plugin location="https://github.com/dj95/zjstatus/releases/latest/download/zjstatus.wasm" {
        format_left   "{mode}#[bg=#161B20] {tabs}"
        format_center ""
        format_right "{command_git_branch} #[bg=#161B20,fg=#88ACC4]#[bg=#88ACC4,fg=#161B20,bold] #[bg=#C3C8CC,fg=#161B20,bold] {session}"
        format_space  ""
        format_hide_on_overlength "true"
        format_precedence "crl"

        border_enabled  "false"
        border_char     "─"
        border_format   "#[fg=#3A424B]{char}"
        border_position "top"

        mode_normal "#[bg=#9AA4AE,fg=#161B20,bold] NORMAL#[bg=#161B20,fg=#9AA4AE]█"
        mode_locked "#[bg=#E3888C,fg=#161B20,bold] LOCKED #[bg=#161B20,fg=#E3888C]█"
        mode_resize "#[bg=#EB9E83,fg=#161B20,bold] RESIZE#[bg=#161B20,fg=#EB9E83]█"
        mode_pane   "#[bg=#88ACC4,fg=#161B20,bold] PANE#[bg=#161B20,fg=#88ACC4]█"
        mode_tab    "#[bg=#88ACC4,fg=#161B20,bold] TAB#[bg=#161B20,fg=#88ACC4]█"
        mode_scroll "#[bg=#D8C08A,fg=#161B20,bold] SCROLL#[bg=#161B20,fg=#D8C08A]█"
        mode_search "#[bg=#88ACC4,fg=#161B20,bold] SEARCH#[bg=#161B20,fg=#88ACC4]█"
        mode_session "#[bg=#88ACC4,fg=#161B20,bold] SESSION#[bg=#161B20,fg=#88ACC4]█"
        mode_move "#[bg=#C7A0D8,fg=#161B20,bold] MOVE#[bg=#161B20,fg=#C7A0D8]█"
        mode_prompt "#[bg=#88ACC4,fg=#161B20,bold] PROMPT#[bg=#161B20,fg=#88ACC4]█"
        mode_tmux "#[bg=#EB9E83,fg=#161B20,bold] TMUX#[bg=#161B20,fg=#EB9E83]█"

        tab_normal "#[bg=#161B20,fg=#88ACC4]█#[bg=#88ACC4,fg=#161B20,bold]{index} #[bg=#2A3138,fg=#88ACC4,bold] {name}#[bg=#161B20,fg=#2A3138]█"
        tab_active "#[bg=#161B20,fg=#EB9E83]█#[bg=#EB9E83,fg=#161B20,bold]{index} #[bg=#2A3138,fg=#EB9E83,bold] {name}#[bg=#161B20,fg=#2A3138]█"
        tab_normal_fullscreen "#[bg=#161B20,fg=#88ACC4]█#[bg=#88ACC4,fg=#161B20,bold]{index} #[bg=#2A3138,fg=#88ACC4,bold] {name}{fullscreen_indicator}#[bg=#161B20,fg=#2A3138]█"
        tab_active_fullscreen "#[bg=#161B20,fg=#EB9E83]█#[bg=#EB9E83,fg=#161B20,bold]{index} #[bg=#2A3138,fg=#EB9E83,bold] {name}{fullscreen_indicator}#[bg=#161B20,fg=#2A3138]█"
        tab_separator "#[bg=#161B20] "
        tab_sync_indicator " "
        tab_fullscreen_indicator " 󰊓"
        tab_floating_indicator " 󰹙"

        command_git_branch_command "git rev-parse --abbrev-ref HEAD"
        command_git_branch_format "#[fg=#88ACC4,bold] {stdout}"
        command_git_branch_interval "10"
      }
    }
  }
}
