layout {
  swap_tiled_layout name="vertical" {
    tab max_panes=5 {
      pane split_direction="vertical" {
        pane {
          children;
        }
        pane
      }
    }
    tab max_panes=8 {
      pane split_direction="vertical" {
        pane {
          children;
        }
        pane {
          pane
          pane
          pane
          pane
        }
      }
    }
    tab max_panes=12 {
      pane split_direction="vertical" {
        pane {
          children;
        }
        pane {
          pane
          pane
          pane
          pane
        }
        pane {
          pane
          pane
          pane
          pane
        }
      }
    }
  }
  swap_tiled_layout name="horizontal" {
    tab max_panes=5 {
      pane
      pane
    }
    tab max_panes=8 {
      pane {
        pane split_direction="vertical" {
          children;
        }
        pane split_direction="vertical" {
          pane
          pane
          pane
          pane
        }
      }
    }
    tab max_panes=12 {
      pane {
        pane split_direction="vertical" {
          children;
        }
        pane split_direction="vertical" {
          pane
          pane
          pane
          pane
        }
        pane split_direction="vertical" {
          pane
          pane
          pane
          pane
        }
      }
    }
  }
  swap_tiled_layout name="stacked" {
    tab min_panes=5 {
      pane split_direction="vertical" {
        pane
        pane stacked=true {
          children;
        }
      }
    }
  }
  swap_floating_layout name="staggered" {
    floating_panes
  }
  swap_floating_layout name="enlarged" {
    floating_panes max_panes=10 {
      pane { x "5%"; y 1; width "90%"; height "90%"; }
      pane { x "5%"; y 2; width "90%"; height "90%"; }
      pane { x "5%"; y 3; width "90%"; height "90%"; }
      pane { x "5%"; y 4; width "90%"; height "90%"; }
      pane { x "5%"; y 5; width "90%"; height "90%"; }
      pane { x "5%"; y 6; width "90%"; height "90%"; }
      pane { x "5%"; y 7; width "90%"; height "90%"; }
      pane { x "5%"; y 8; width "90%"; height "90%"; }
      pane { x "5%"; y 9; width "90%"; height "90%"; }
      pane focus=true { x 10; y 10; width "90%"; height "90%"; }
    }
  }
  swap_floating_layout name="spread" {
    floating_panes max_panes=1 {
      pane { x "50%"; y "50%"; }
    }
    floating_panes max_panes=2 {
      pane { x "1%"; y "25%"; width "45%"; }
      pane { x "50%"; y "25%"; width "45%"; }
    }
    floating_panes max_panes=3 {
      pane focus=true { y "55%"; width "45%"; height "45%"; }
      pane { x "1%"; y "1%"; width "45%"; }
      pane { x "50%"; y "1%"; width "45%"; }
    }
    floating_panes max_panes=4 {
      pane { x "1%"; y "55%"; width "45%"; height "45%"; }
      pane focus=true { x "50%"; y "55%"; width "45%"; height "45%"; }
      pane { x "1%"; y "1%"; width "45%"; height "45%"; }
      pane { x "50%"; y "1%"; width "45%"; height "45%"; }
    }
  }
  default_tab_template {
    pane size=1 borderless=true {
      plugin location="zellij:status-bar"
    }
    pane {
      children;
    }
    pane size=2 borderless=true {
      plugin location="https://github.com/dj95/zjstatus/releases/latest/download/zjstatus.wasm" {
        format_left   "{mode}#[bg=#161B20] {tabs}"
        format_center ""
        format_right "{command_git_branch} {command_docker} #[bg=#161B20,fg=#88ACC4]#[bg=#88ACC4,fg=#161B20,bold] #[bg=#C3C8CC,fg=#161B20,bold] {session} #[bg=#161B20,fg=#9AA4AE] {datetime}"
        format_space  ""
        format_hide_on_overlength "true"
        format_precedence "crl"
    
        border_enabled  "false"
        border_char     "─"
        border_format   "#[fg=#3A424B]{char}"
        border_position "top"
    
        mode_normal "#[bg=#88C0A8,fg=#161B20,bold] NORMAL#[bg=#161B20,fg=#88C0A8]█"
        mode_locked "#[bg=#E3888C,fg=#161B20,bold] LOCKED #[bg=#161B20,fg=#E3888C]█"
        mode_resize "#[bg=#EB9E83,fg=#161B20,bold] RESIZE#[bg=#161B20,fg=#EB9E83]█"
        mode_pane   "#[bg=#88ACC4,fg=#161B20,bold] PANE#[bg=#161B20,fg=#88ACC4]█"
        mode_tab    "#[bg=#88ACC4,fg=#161B20,bold] TAB#[bg=#161B20,fg=#88ACC4]█"
        mode_scroll "#[bg=#D8C08A,fg=#161B20,bold] SCROLL#[bg=#161B20,fg=#D8C08A]█"
        mode_search "#[bg=#88ACC4,fg=#161B20,bold] SEARCH#[bg=#161B20,fg=#88ACC4]█"
        mode_session "#[bg=#88ACC4,fg=#161B20,bold] SESSION#[bg=#161B20,fg=#88ACC4]█"
        mode_move "#[bg=#C7A0D8,fg=#161B20,bold] MOVE#[bg=#161B20,fg=#C7A0D8]█"
        mode_prompt "#[bg=#88ACC4,fg=#161B20,bold] PROMPT#[bg=#161B20,fg=#88ACC4]█"
        mode_tmux "#[bg=#EB9E83,fg=#161B20,bold] TMUX#[bg=#161B20,fg=#EB9E83]█"
    
        tab_normal "#[bg=#161B20,fg=#88ACC4]█#[bg=#88ACC4,fg=#161B20,bold]{index} #[bg=#2A3138,fg=#88ACC4,bold] {name}#[bg=#161B20,fg=#2A3138]█"
        tab_active "#[bg=#161B20,fg=#EB9E83]█#[bg=#EB9E83,fg=#161B20,bold]{index} #[bg=#2A3138,fg=#EB9E83,bold] {name}#[bg=#161B20,fg=#2A3138]█"
        tab_normal_fullscreen "#[bg=#161B20,fg=#88ACC4]█#[bg=#88ACC4,fg=#161B20,bold]{index} #[bg=#2A3138,fg=#88ACC4,bold] {name}{fullscreen_indicator}#[bg=#161B20,fg=#2A3138]█"
        tab_active_fullscreen "#[bg=#161B20,fg=#EB9E83]█#[bg=#EB9E83,fg=#161B20,bold]{index} #[bg=#2A3138,fg=#EB9E83,bold] {name}{fullscreen_indicator}#[bg=#161B20,fg=#2A3138]█"
        tab_separator "#[bg=#161B20] "
        tab_sync_indicator " "
        tab_fullscreen_indicator " 󰊓"
        tab_floating_indicator " 󰹙"
    
        command_git_branch_command "bash -c 'git rev-parse --git-dir >/dev/null 2>&1 && { [ -n \"$(git status --porcelain 2>/dev/null)\" ] && printf \"⚡\" || printf \"✓\"; }; git rev-parse --abbrev-ref HEAD 2>/dev/null'"
        command_git_branch_format "#[fg=#88ACC4,bold] {stdout}"
        command_git_branch_interval "10"
        command_docker_command "bash -c 'n=$(docker ps -q 2>/dev/null | wc -l); [ \"$n\" -gt 0 ] && printf \"🐳%s\" \"$n\"'"
      
      }
    }
  }
}
