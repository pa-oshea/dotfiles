[user]
    name = Patrick O'Shea
    email = p14oshea@gmail.com

[includeIf "gitdir:~/work/"]
    path = ~/.gitconfig-work

[core]
    pager = delta
    editor = nvim
    autocrlf = input
    ignorecase = false

[init]
    defaultBranch = main

[pager]
    blame = delta
    diff = delta
    log = delta
    reflog = delta
    show = delta

[interactive]
    diffFilter = delta --color-only --features=interactive

[delta "catppuccin-mocha"]
    blame-palette = "#1e1e2e #181825 #11111b #313244 #45475a"
    commit-decoration-style = "#6c7086" bold box ul
    dark = true
    file-decoration-style = "#6c7086"
    file-style = "#cdd6f4"
    hunk-header-decoration-style = "#6c7086" box ul
    hunk-header-file-style = bold
    hunk-header-line-number-style = bold "#a6adc8"
    hunk-header-style = file line-number syntax
    line-numbers-left-style = "#6c7086"
    line-numbers-minus-style = bold "#f38ba8"
    line-numbers-plus-style = bold "#a6e3a1"
    line-numbers-right-style = "#6c7086"
    line-numbers-zero-style = "#6c7086"
    # 25% red 75% base
    minus-emph-style = bold syntax "#53394c"
    # 10% red 90% base
    minus-style = syntax "#34293a"
    # 25% green 75% base
    plus-emph-style = bold syntax "#404f4a"
    # 10% green 90% base
    plus-style = syntax "#2c3239"
    map-styles = \
      bold purple => syntax "#494060", \
      bold blue => syntax "#384361", \
      bold cyan => syntax "#384d5d", \
      bold yellow => syntax "#544f4e"
    # Should match the name of the bat theme
    syntax-theme = Catppuccin Mocha

[delta "token-flint-dark"]
	dark = true
	syntax-theme = token-flint-dark
	blame-palette = "#1C2127 #22272E #272C33 #30363E #373E47"
	commit-decoration-style = "#626C77" bold box ul
	file-style = "#DCE1E6"
	file-decoration-style = "#626C77"
  hunk-header-style = file line-number syntax
	hunk-header-decoration-style = "#626C77" box ul
	hunk-header-file-style = bold
	hunk-header-line-number-style = bold "#929BA5"
	line-numbers-left-style = "#626C77"
	line-numbers-right-style = "#626C77"
	line-numbers-minus-style = bold "#D47A7F"
	line-numbers-plus-style = bold "#94A477"
	line-numbers-zero-style = "#929BA5"
	minus-style = syntax "#4A3035"
	minus-non-emph-style = syntax "#4A3035"
	minus-emph-style = bold "#DCE1E6" "#613940"
	minus-empty-line-marker-style = syntax "#4A3035"
	plus-style = syntax "#364338"
	plus-non-emph-style = syntax "#364338"
	plus-emph-style = bold "#DCE1E6" "#455746"
	plus-empty-line-marker-style = syntax "#364338"
	map-styles = "bold purple => syntax '#494231', bold cyan => syntax '#494231'"

[delta "token-flint-light"]
	light = true
	syntax-theme = token-flint-light
	blame-palette = "#E7EBEF #EEF1F3 #F5F7F8 #EBEFF2 #E0E5EA"
	commit-decoration-style = "#828E9A" bold box ul
	file-style = "#28313A"
	file-decoration-style = "#828E9A"
	hunk-header-style = file line-number syntax
	hunk-header-decoration-style = "#828E9A" box ul
	hunk-header-file-style = bold
	hunk-header-line-number-style = bold "#65717D"
	line-numbers-left-style = "#828E9A"
	line-numbers-right-style = "#828E9A"
	line-numbers-minus-style = bold "#BE3E50"
	line-numbers-plus-style = bold "#5A772B"
	line-numbers-zero-style = "#65717D"
	minus-style = syntax "#F2DEE1"
	minus-non-emph-style = syntax "#F2DEE1"
	minus-emph-style = bold "#28313A" "#E7C8CD"
	minus-empty-line-marker-style = syntax "#F2DEE1"
	plus-style = syntax "#E1E9D9"
	plus-non-emph-style = syntax "#E1E9D9"
	plus-emph-style = bold "#28313A" "#CCDABF"
	plus-empty-line-marker-style = syntax "#E1E9D9"
	map-styles = "bold purple => syntax '#ECE5D5', bold cyan => syntax '#ECE5D5'"

[delta]
    features = token-flint-dark
    navigate = true              # use n and N to move between diff sections
    line-numbers = true
    hyperlinks = true
    side-by-side = true

[delta "interactive"]
    keep-plus-minus-markers = false

[delta "decorations"]
    commit-decoration-style = blue ol
    commit-style = raw
    file-style = omit
    hunk-header-decoration-style = blue box
    hunk-header-file-style = red
    hunk-header-line-number-style = "#067a00"
    hunk-header-style = file line-number syntax

[merge]
    conflictstyle = diff3
    tool = nvim

[mergetool "nvim"]
    cmd = nvim -d $LOCAL $REMOTE $MERGED -c '$wincmd w' -c 'wincmd J'

[diff]
    colorMoved = default
    algorithm = histogram

[pull]
    rebase = true

[push]
    default = simple
    followTags = true
    autoSetupRemote = true

[rebase]
    autoStash = true
    autoSquash = true

[fetch]
    prune = true
    prunetags = true

[status]
    showUntrackedFiles = all

[log]
    date = relative

[format]
    pretty = format:%C(bold blue)%h%C(reset) - %C(bold green)(%ar)%C(reset) %C(white)%s%C(reset) %C(dim white)- %an%C(reset)%C(bold yellow)%d%C(reset)

[color]
    ui = auto

[color "branch"]
    current = yellow reverse
    local = yellow
    remote = green

[color "diff"]
    meta = yellow bold
    frag = magenta bold
    old = red bold
    new = green bold

[color "status"]
    added = yellow
    changed = green
    untracked = cyan

# Aliases
[alias]
    # Basic shortcuts
    co = checkout
    br = branch
    ci = commit
    st = status
    
    # Enhanced shortcuts
    s = status -sb
    a = add
    aa = add --all
    cm = commit -m
    cam = commit -am
    
    # Branching
    cob = checkout -b
    bd = branch -d
    bD = branch -D
    
    # Logging
    l = log --oneline
    lg = log --color --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit
    ll = log --stat
    lp = log --patch
    
    # Diffs
    d = diff
    dc = diff --cached
    ds = diff --staged
    
    # Remote operations
    f = fetch
    fa = fetch --all
    p = push
    pl = pull
    pom = push origin main
    pod = push origin dev
    
    # Stashing
    ss = stash save
    sp = stash pop
    sl = stash list
    
    # Undoing things
    unstage = reset HEAD --
    undo = reset --soft HEAD~1
    amend = commit --amend --no-edit
    
    # Information
    who = blame
    tags = tag -l
    branches = branch -a
    remotes = remote -v
    
    # Cleanup
    cleanup = "!git branch --merged | grep -v '\\*\\|main\\|master\\|dev\\|develop' | xargs -n 1 git branch -d"
    
    # Advanced
    absorb = absorb --and-rebase
    fixup = commit --fixup
    squash = commit --squash
    
    # Working with GitHub
    pr = "!gh pr create"
    prs = "!gh pr list"
    
    # File operations
    ls = ls-files
    ignored = ls-files --others --ignored --exclude-standard
    
    # Searching
    grep = grep -Ii
    find = "!git ls-files | grep -i"
    
    # Configuration
    aliases = config --get-regexp alias
    
    # Quick commit with message
    quick = "!f() { git add -A && git commit -m \"$1\"; }; f"

[help]
    autocorrect = 1

[rerere]
    enabled = true

[branch]
    autosetupmerge = true
    autosetuprebase = always

[credential]
    helper = cache --timeout=3600

# GitHub CLI integration
[gh]
    protocol = https

# Git LFS (Large File Storage)
[filter "lfs"]
    clean = git-lfs clean -- %f
    smudge = git-lfs smudge -- %f
    process = git-lfs filter-process
    required = true

# URL rewrites for better performance
[url "https://github.com/"]
    insteadOf = gh:
    insteadOf = github:
